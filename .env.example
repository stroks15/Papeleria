NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor/Vercel. Nunca uses estas llaves con NEXT_PUBLIC_.
GEMINI_API_KEY=
GROQ_API_KEY=

# Modelos estables/actuales; se pueden sobreescribir en Vercel.
GEMINI_AI_MODEL=gemini-3.8-flash
GROQ_AI_MODEL=qwen/qwen3.8-27b
# Opcional: Grok (xAI) como tercer respaldo
XAI_API_KEY=
XAI_AI_MODEL=grok-4

# URL del backend cuando la APK usa el frontend exportado.
NEXT_PUBLIC_ASSISTANT_API_URL=https://papeleria-flax.vercel.app

# --- Ventanilla CDMX (solo servidor) ---
# La integración Vercel-Supabase inyecta SUPABASE_URL / NEXT_PUBLIC_SUPABASE_URL y
# SUPABASE_SERVICE_ROLE_KEY. Nunca uses la service_role con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Servicio Python (lib/servicios_cdmx.py serve). Si no se define, la API responde
# REQUIRES_VIEWPORT_FALLBACK y la app usa el WebView embebido.
CDMX_SCRAPER_URL=
CDMX_SCRAPER_TOKEN=
# Orígenes extra permitidos por CORS (la APK ya está incluida), separados por comas.
ALLOWED_ORIGINS=
# Endpoints oficiales/autorizados que consume el scraper ({placa} se sustituye).
TENENCIA_API_URL=
VERIFICACION_API_URL=
